# Copie para .env.local e preencha. NUNCA commite .env.local (já está no .gitignore).

# --- Supabase ---
# Dashboard: Settings > API. A URL é só a base (https://xxx.supabase.co),
# SEM /rest/v1 no fim — o SDK monta o caminho sozinho.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role: só no servidor/worker. Bypassa RLS. Nunca exponha no browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google AI (imagem + direção + vídeo) ---
# aistudio.google.com/apikey
# Uma chave só: Nano Banana Pro (imagem), Flash-Lite (direção/copy), Omni Flash (vídeo).
GOOGLE_API_KEY=

# --- Admin / custos (opcional) ---
# Email que enxerga o painel /admin (custos). Deixe vazio pra ninguém ver.
# Deve bater com o email de login desse usuário no Supabase.
ADMIN_EMAIL=
# Teto de gasto por conta, por mês, em R$. Vazio ou 0 = sem teto.
# Ex.: 300 barra novas fotos/vídeos quando a conta passa de R$300 no mês.
TETO_MENSAL_BRL=

# --- Backend de vídeo (opcional) ---
# omni (PADRÃO) = gemini-omni-flash-preview, via Interactions API. 720p, síncrono.
# veo = veo-3.1-fast. 1080p e com personGeneration:"allow_adult", o opt-in que
#   libera gerar vídeo com pessoa na imagem. Plano B se o Omni barrar no filtro.
VIDEO_BACKEND=
